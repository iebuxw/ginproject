MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=请修改为你的密码
MYSQL_DATABASE=ginadmin

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=请修改为随机字符串
JWT_EXPIRE_HOURS=24

SERVER_PORT=8000

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=请修改为发件账号
SMTP_PASSWORD=请修改为发件密码/授权码
SMTP_FROM=请修改为发件人地址
SMTP_TO=请修改为告警接收邮箱

# Elasticsearch（学习用单节点，7.17 无安全认证；docker 内用服务名，本地 go run 用 127.0.0.1）
ES_HOST=elasticsearch
ES_PORT=9200
ES_USERNAME=
ES_PASSWORD=

# 日志定时清理接口密钥（公开路由防滥用，定时任务 URL 中携带）
LOG_CLEANUP_SECRET=请修改为随机字符串
